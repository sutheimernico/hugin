# hugin — environment overrides. Copy to .env (gitignored) and change what you need.
# Every variable is optional; the defaults in src/hugin/settings.py are the source of truth.

# Interface the API binds to. Keep it on loopback — hugin has no auth.
HUGIN_HOST=127.0.0.1
# API port; scripts/serve.sh and the Vite dev proxy assume this one.
HUGIN_PORT=8770

# Repository root; used to resolve the directories below.
# HUGIN_REPO_ROOT=/path/to/hugin
# SQLite database and other derived state (gitignored).
# HUGIN_DATA_DIR=/path/to/hugin/data
# Per-process agent working directories runs/<run_id>/p<pid>/ (gitignored).
# HUGIN_RUNS_DIR=/path/to/hugin/runs
# Isolated Claude config dir for agents: no user hooks, no user MCP servers, no user CLAUDE.md.
# HUGIN_CLAUDE_CONFIG_DIR=/path/to/hugin/.hugin/claude-config
# Scrubbed event logs that power the offline demo (committed).
# HUGIN_RECORDINGS_DIR=/path/to/hugin/demo/recordings

# Claude Code binary used by ClaudeCodeDriver. Runs on the subscription — never with an API key.
HUGIN_CLAUDE_BIN=claude
# Local Ollama endpoint and model for OllamaDriver.
HUGIN_OLLAMA_URL=http://127.0.0.1:11434
HUGIN_OLLAMA_MODEL=qwen2.5:7b

# Scheduler concurrency per driver, JSON object.
HUGIN_MAX_CONCURRENT={"claude": 3, "ollama": 3, "scripted": 8}
# Kernel log ring buffer size (events kept in the shell).
HUGIN_LOG_RING=5000
